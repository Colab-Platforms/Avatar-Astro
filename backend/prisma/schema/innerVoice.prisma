// Free-tier limiter for the Inner Voice chat (/inner-voice/chat): each user gets
// DAILY_CHAT_DURATION_SECONDS of chat per Asia/Kolkata calendar day, starting from
// their first message of the day. One row per (user, day) — the backend is the
// only writer of startedAt/expiresAt, so the frontend clock can never extend it.
model DailyChatUsage {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Calendar date in Asia/Kolkata, stored as a date (no time component).
  usageDate DateTime @map("usage_date") @db.Date

  startedAt DateTime @map("started_at")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@unique([userId, usageDate])
  @@index([userId])
  @@map("daily_chat_usages")
}

/// Messages in /inner-voice/chat that must NOT get an AI reply (personal-contact requests,
/// "are you human?" probes, ...). A super admin works this queue and contacts the user directly.
model ChatEscalation {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String
  /// PERSONAL_CONTACT | IDENTITY_PROBE
  reason  String
  /// PENDING | CONTACTED | DISMISSED
  status  String @default("PENDING")

  adminNote   String?   @map("admin_note")
  handledById String?   @map("handled_by_id")
  handledAt   DateTime? @map("handled_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("chat_escalations")
}

/// One generated weekly horoscope per Sun sign per week (Monday to Sunday, Asia/Kolkata). The first request of the week
/// generates and stores it; every later request for the same sign and week returns this row.
model WeeklyHoroscope {
  id String @id @default(cuid())

  /// Lower-case Sun-sign name, e.g. "aries".
  sign      String
  /// The Monday that starts the week, in Asia/Kolkata, stored as a date (no time component).
  weekStart DateTime @map("week_start") @db.Date
  /// Validated sections: { overview, career, love, finance, health, family, advice, lucky? }.
  content   Json
  model     String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sign, weekStart])
  @@map("weekly_horoscopes")
}

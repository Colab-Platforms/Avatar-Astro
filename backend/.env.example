# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq — server-side only. Powers /api/ai/chat (AI Guru, Know Your Karma, Karma
# Score, Sacred Shloka). Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Optional; must support JSON mode. Groq retires models periodically, so update
# this value instead of hardcoding a new one.
GROQ_MODEL=openai/gpt-oss-120b

# YouTube Data API v3 (Live Darshan)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Publicly reachable HTTPS base URL of this backend — required so YouTube's
# WebSub (PubSubHubbub) hub can push "channel went live" notifications to
# /api/darshan/websub/callback instead of us polling for them.
BACKEND_PUBLIC_URL=https://avatar-astro33-backend.onrender.com
# Safety-net poll interval (seconds) for channels currently marked live, to
# catch "stream ended" (WebSub doesn't reliably push that event). Cheap: 1
# YouTube quota unit per currently-live channel per check.
DARSHAN_LIVE_CHECK_INTERVAL_SECONDS=120
# Cloudinary (admin temple image uploads — server-side only, never exposed to the frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin panel: optional second lock. When set, only the SUPERADMIN account with this email can use /api/admin panel modules.
MAIN_ADMIN_EMAIL=

# Optional: signs YouTube WebSub notifications (hub.secret). When set, forged POSTs to
# /api/darshan/websub/callback are rejected with 403. Subscriptions pick it up on the next renewal.
DARSHAN_WEBSUB_SECRET=
# Optional: how long a signed-in account's active/deactivated status is cached per server (ms). Default 5000.
ACCOUNT_STATUS_TTL_MS=

# AI cost tracking (SUPERADMIN reports). OpenRouter reports exact cost; other providers are estimated only if priced here.
# Format: {"groq:openai/gpt-oss-120b":{"inputPerM":0.15,"outputPerM":0.6},"sarvam:*":{...}}  (USD per 1M tokens, from the provider's pricing page)
# Models with no entry get NO cost (never guessed). Set AI_USAGE_ACCOUNTING=off to disable capture.
AI_PRICING_JSON=
AI_USAGE_ACCOUNTING=
# Optional, display only: show costs in INR as well (costs are stored in USD).
USD_TO_INR_RATE=
# Optional: OpenRouter MANAGEMENT key. Enables the account-level credits balance; the normal key only exposes key-level usage/limit.
OPENROUTER_MANAGEMENT_KEY=

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration — legacy only. The live darshan feature now runs on
# Prisma/Postgres (DATABASE_URL, set separately). This is kept only because
# a few unwired legacy files (src/models/User.ts, Kundali.ts, Horoscope.ts,
# authController.ts, kundaliController.ts, birthDataController.ts) still
# import mongoose; none of their routes are mounted in index.ts.
MONGODB_URI=mongodb://localhost:27017/astrology
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/astrology

# Optional. Leave unset by default — most environments don't need this.
# Only set it if connecting fails with "querySrv ECONNREFUSED
# _mongodb._tcp.<cluster>.mongodb.net": some local/router DNS resolvers
# refuse SRV queries from Node's resolver even though the OS resolver
# handles them fine, which breaks mongodb+srv:// connection strings.
# Comma-separated list of DNS servers to use instead, e.g.:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

OPENROUTER_API_KEY=your_openrouter_api_key_here

# YouTube Data API v3 (Live Darshan)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# Publicly reachable HTTPS base URL of this backend — required so YouTube's
# WebSub (PubSubHubbub) hub can push "channel went live" notifications to
# /api/darshan/websub/callback instead of us polling for them.
BACKEND_PUBLIC_URL=https://avatar-astro33-backend.onrender.com
# Safety-net poll interval (seconds) for channels currently marked live, to
# catch "stream ended" (WebSub doesn't reliably push that event). Cheap: 1
# YouTube quota unit per currently-live channel per check.
DARSHAN_LIVE_CHECK_INTERVAL_SECONDS=120
# Cloudinary (admin temple image uploads — server-side only, never exposed to the frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

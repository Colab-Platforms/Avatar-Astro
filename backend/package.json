{
  "name": "astrology-backend",
  "version": "1.0.0",
  "description": "Astrology API Backend",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate",
    "build": "tsc && tsc-alias",
    "start": "node dist/src/index.js",
    "lint": "eslint src --ext .ts",
    "test:gemstone": "tsx --test src/modules/gemstone/__tests__/*.test.ts",
    "db:seed": "tsx prisma/seeds/index.ts",
    "db:seed:puja": "tsx prisma/seeds/pujaTemples.ts",
    "db:seed:chadhawa": "tsx prisma/seeds/chadhawaOfferings.ts",
    "db:seed:shop": "tsx prisma/seeds/shopProducts.ts",
    "db:seed:darshan": "tsx prisma/seeds/darshanChannels.ts",
    "local:db": "node scripts/local-test/db.mjs",
    "local:setup": "node scripts/local-test/setup.mjs",
    "local:backend": "node scripts/local-test/backend.mjs",
    "local:frontend": "node scripts/local-test/frontend.mjs",
    "db:make-superadmin": "tsx prisma/seeds/makeSuperAdmin.ts",
    "test:ai": "tsx --test src/__tests__/routes/aiRoutes.node-test.ts",
    "test:tarot": "tsx --test src/__tests__/routes/tarotRoutes.node-test.ts",
    "test:websub": "tsx --test src/__tests__/routes/websub.node-test.ts",
    "test:admin": "tsx --test src/__tests__/routes/adminPanel.node-test.ts",
    "test:inquiry": "tsx --test src/__tests__/routes/inquiryRoutes.node-test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "keywords": [
    "astrology",
    "api",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/multer": "^2.2.0",
    "astronomy-engine": "^2.1.19",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.21",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "google-auth-library": "^11.0.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  }
}

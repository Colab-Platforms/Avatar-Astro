# Backend API Configuration
# This default only matters for one-off `vite`/`vite build` runs without a
# mode-specific file present. In this repo, .env.development (localhost) and
# .env.production (Render) already set VITE_API_URL per mode — Vite picks the
# right one automatically for `npm run dev` vs `npm run build`.
VITE_API_URL=http://localhost:5000/api

# Google Identity Services client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Environment
VITE_ENV=development

# Sarvam AI TTS — get your key at https://sarvam.ai
VITE_SARVAM_API_KEY=your_sarvam_api_key_here

# AI requests (AI Guru, Know Your Karma, Karma Score, Sacred Shloka) go through the
# backend (/api/ai/chat). The Groq key lives ONLY in backend/.env (GROQ_API_KEY) —
# never add a VITE_GROQ_* variable: anything prefixed VITE_ is bundled into public JS.

# Footer social links. An icon is shown only when its URL is set (no placeholder links).
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TWITTER=

# Public URL of the deployed solar-system-app (embedded at /solar-system). Required in production;
# in development it defaults to http://localhost:3000 (run `npm start` in /solar-system-app).
VITE_SOLAR_SYSTEM_URL=

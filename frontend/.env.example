# Backend API Configuration
# This default only matters for one-off `vite`/`vite build` runs without a
# mode-specific file present. In this repo, .env.development (localhost) and
# .env.production (Render) already set VITE_API_URL per mode — Vite picks the
# right one automatically for `npm run dev` vs `npm run build`.
VITE_API_URL=http://localhost:5000/api

# Google Identity Services client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Environment
VITE_ENV=development

# Sarvam AI TTS — get your key at https://sarvam.ai
VITE_SARVAM_API_KEY=your_sarvam_api_key_here

# Groq — powers AI Guru consultation, Karma Diagnosis, Karma Dashboard,
# Karma Journal, and Shloka Wisdom. Get your key at https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here
# Model must support json_mode. Check currently available models with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $VITE_GROQ_API_KEY"
# Groq periodically retires older models (e.g. llama-3.3-70b-versatile was
# retired) — if consultations start failing with a "model does not exist"
# error, that's why; update this value rather than hardcoding a new one.
VITE_GROQ_MODEL=openai/gpt-oss-120b
